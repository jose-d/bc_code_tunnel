<%
require "yaml"

site_config_path =
  ENV["OOD_CODE_TUNNEL_SITE_CONFIG"] || "/etc/ood/apps/sys/code_tunnel/site.yml"
site_config =
  if File.file?(site_config_path)
    YAML.safe_load(File.read(site_config_path), aliases: true) || {}
  else
    {}
  end

submit_native = site_config["submit_native"]
submit_native = [] unless submit_native.is_a?(Array)

submit_config = site_config["submit"]
submit_config = {} unless submit_config.is_a?(Hash)

gpu_count_config = site_config["gpu_count"]
gpu_count_config = {} unless gpu_count_config.is_a?(Hash)

partition_in_native = submit_config["partition_in_native"] == true
time_format = submit_config["time_format"] || "hours"
memory_format = submit_config["memory_format"] || "gb"
nodes = submit_config.fetch("nodes", 1).to_i
ntasks = submit_config.fetch("ntasks", 1).to_i
qos = submit_config["qos"]

time_value =
  if time_format == "minutes"
    (tunnel_hours.to_i * 60).to_s
  else
    "#{tunnel_hours.to_i}:00:00"
  end

memory_value =
  if memory_format == "mib"
    (num_mem.to_i * 1024).to_s
  else
    "#{num_mem.to_i}G"
  end

gpu_partitions = gpu_count_config["partitions"]
gpu_partitions = [] unless gpu_partitions.is_a?(Array)
gpu_gres = gpu_count_config["gres"]
selected_gpu_count = defined?(gpu_count) ? gpu_count.to_i : 0
add_gpu_gres =
  gpu_count_config["enabled"] == true &&
  gpu_gres.to_s != "" &&
  selected_gpu_count > 0 &&
  gpu_partitions.include?(custom_queue.to_s)
%>
---
batch_connect:
  template: "basic"

script:
<% unless partition_in_native %>
  queue_name: <%= custom_queue %>
<% end %>
  native:
    - "--nodes=<%= nodes %>"
    - "--ntasks=<%= ntasks %>"
<% if partition_in_native %>
    - "--partition=<%= custom_queue %>"
<% end %>
    - "--time=<%= time_value %>"
<% if qos && !qos.to_s.empty? %>
    - "--qos=<%= qos %>"
<% end %>
    - "--cpus-per-task=<%= num_cpus.to_i %>"
    - "--mem=<%= memory_value %>"
<% if add_gpu_gres %>
    - "--gres=<%= gpu_gres %>:<%= selected_gpu_count %>"
<% end %>
<% submit_native.each do |arg| %>
    - "<%= arg %>"
<% end %>
