cluster: my_cluster

default_partition: compute
partition_help: Replace these example partitions with values valid for your site.
partitions:
  - label: Compute
    value: compute
  - label: GPU
    value: gpu
    form_options:
      data-hide-gpu-count: "false"
      data-set-gpu-count: "1"

gpu_count:
  enabled: true
  label: GPU count
  hide_by_default: true
  partitions: [gpu]
  gres: gpu
  options:
    - ["0 GPUs", "0"]
    - ["1 GPU", "1"]
  default: "0"
  help: Only used when a GPU partition is selected.

hours:
  - [4 hours, "4"]
  - [8 hours, "8"]
  - [16 hours, "16"]
default_hours: "8"

cpus:
  - ["4", "4"]
  - ["8", "8"]
  - ["16", "16"]
default_num_cpus: "4"

memory_gb:
  - ["16", "16"]
  - ["32", "32"]
  - ["64", "64"]
  - ["128", "128"]
default_memory_gb: "16"

submit:
  partition_in_native: false
  time_format: hours
  memory_format: gb
  nodes: 1
  ntasks: 1

submit_native: []

paths:
  code: /usr/bin/code
  ttyd: /usr/bin/ttyd
